# Copy to .env; never commit a real password or token.
# For personal data use PM_DEMO_MODE=false and your own 12+ character password.
PM_DEMO_MODE=true
PM_ORIGIN=http://127.0.0.1:4180
PM_DATABASE_URL=sqlite:///data/memory.db
PM_MODEL_BACKEND=extractive
PM_OLLAMA_URL=http://127.0.0.1:11434
PM_MODEL=qwen3.5:9b
PM_EMBEDDING_MODEL=bge-m3
PM_DENSE_THRESHOLD=0.4
# PM_APP_PASSWORD=
# PM_GITHUB_TOKEN=     # Optional read access only; public repositories need no token.
# PM_DB_PASSWORD=      # Choose your own password for live PostgreSQL containers.
